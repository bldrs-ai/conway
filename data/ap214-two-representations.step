ISO-10303-21;
HEADER;
FILE_DESCRIPTION ('AP214 fixture for the per-representation deflection floor (bldrs-ai/conway#564 5): two advanced-brep representations of very different size, whose GLOBAL_UNIT_ASSIGNED_CONTEXTs also declare different length units. A model-wide extent has no single value that is right for both; the extent of the DEFINING representation does. Pairs with ap214-two-representations-one-unit.step, which is identical except that both contexts declare MILLI METRE.','2;1');
FILE_NAME('ap214-two-representations','2026-01-01T00:00:00',('test'),('bldrs'),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#2);
#2 = APPLICATION_CONTEXT('mechanical design');
#10 = CARTESIAN_POINT('',(0.,0.,0.));
#20 = DIRECTION('',(0.,0.,1.));
#21 = DIRECTION('',(1.,0.,0.));
#30 = AXIS2_PLACEMENT_3D('',#10,#20,#21);
/* millimetre context */
#100 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#104)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#101,#102,#103)) REPRESENTATION_CONTEXT('Context','3D') );
#101 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#102 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#103 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#104 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#101,'','');
/* metre context */
#150 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#154)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#151,#152,#153)) REPRESENTATION_CONTEXT('Context','3D') );
#151 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.) );
#152 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#153 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#154 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#151,'','');
/* the large body: a 1000 x 1000 x 1000 unit span */
#300 = CARTESIAN_POINT('',(0.,0.,0.));
#301 = CARTESIAN_POINT('',(1000.,1000.,1000.));
#302 = VERTEX_POINT('',#300);
#303 = VERTEX_POINT('',#301);
#304 = VECTOR('',#20,1.);
#305 = LINE('',#300,#304);
#306 = EDGE_CURVE('',#302,#303,#305,.T.);
#307 = ORIENTED_EDGE('',*,*,#306,.T.);
#308 = EDGE_LOOP('',(#307));
#309 = FACE_OUTER_BOUND('',#308,.T.);
#310 = PLANE('',#30);
#311 = ADVANCED_FACE('large face',(#309),#310,.T.);
#312 = CLOSED_SHELL('',(#311));
#313 = MANIFOLD_SOLID_BREP('large solid',#312);
/* the small body: a 1 x 1 x 1 unit span */
#400 = CARTESIAN_POINT('',(0.,0.,0.));
#401 = CARTESIAN_POINT('',(1.,1.,1.));
#402 = VERTEX_POINT('',#400);
#403 = VERTEX_POINT('',#401);
#404 = VECTOR('',#20,1.);
#405 = LINE('',#400,#404);
#406 = EDGE_CURVE('',#402,#403,#405,.T.);
#407 = ORIENTED_EDGE('',*,*,#406,.T.);
#408 = EDGE_LOOP('',(#407));
#409 = FACE_OUTER_BOUND('',#408,.T.);
#410 = PLANE('',#30);
#411 = ADVANCED_FACE('small face',(#409),#410,.T.);
#412 = CLOSED_SHELL('',(#411));
#413 = MANIFOLD_SOLID_BREP('small solid',#412);
#500 = ADVANCED_BREP_SHAPE_REPRESENTATION('large body',(#313),#100);
#510 = ADVANCED_BREP_SHAPE_REPRESENTATION('small body',(#413),#150);
#600 = PRODUCT_CONTEXT('',#2,'mechanical');
#601 = PRODUCT_DEFINITION_CONTEXT('part definition',#2,'design');
#610 = PRODUCT('two-reps','two-reps','',(#600));
#611 = PRODUCT_DEFINITION_FORMATION('','',#610);
#612 = PRODUCT_DEFINITION('','',#611,#601);
#613 = PRODUCT_DEFINITION_SHAPE('','',#612);
#614 = SHAPE_DEFINITION_REPRESENTATION(#613,#500);
ENDSEC;
END-ISO-10303-21;
