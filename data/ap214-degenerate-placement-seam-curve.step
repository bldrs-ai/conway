HEADER;
FILE_DESCRIPTION((
'conway#592/#591 behavioral fixture (codex round 2, recursive alias
variant): identical to ap214-degenerate-placement-whole-curve.step, but
the closed edge''s basis curve is a SEAM_CURVE wrapping the degenerate
CIRCLE as curve_3d rather than the CIRCLE directly. extractCurve caches
a surface_curve/seam_curve''s untrimmed extraction under BOTH the
seam_curve''s own localID (outer frame) and curve_3d''s localID (the
recursive call) - a rejected whole-curve-trim recovery has to remove
BOTH aliases before deleting the native object, not just the one keyed
by the EDGE_CURVE''s basis (the seam_curve).'
),'2;1');
FILE_NAME('ap214-degenerate-placement-seam-curve','2026-01-01T00:00:00',(
    'test'),('bldrs'),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
