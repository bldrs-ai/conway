ISO-10303-21;
HEADER;
FILE_DESCRIPTION ('AP214 fixture: one unbound solids representation reachable from two directly SDR-bound representations with different PDS owners, via two plain SHAPE_REPRESENTATION_RELATIONSHIPs. conway#597 review.','2;1');
