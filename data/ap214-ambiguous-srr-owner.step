#400 = SHAPE_REPRESENTATION('partA',(#30),#100);
#401 = PRODUCT_DEFINITION_SHAPE('','',#222);
#402 = SHAPE_DEFINITION_REPRESENTATION(#401,#400);
#410 = SHAPE_REPRESENTATION('partB',(#30),#100);
#411 = PRODUCT_DEFINITION_SHAPE('','',#232);
#412 = SHAPE_DEFINITION_REPRESENTATION(#411,#410);
#420 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#431),#100);
