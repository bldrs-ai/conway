/* --- fixture additions (conway#579 / codex round 1) ---------------------
   A MAPPED_ITEM that PUSHES a transform and then THROWS.

   extractMappedItem reads mapping_source / mapping_target / mapping_origin,
   pushes the mapping transform, and only then dereferences
   `representationMap.mapped_representation.items`. #900014's
   mapped_representation points at a CARTESIAN_POINT, so that dereference
   fails AFTER the push and the function's pop loop is never reached.

   The leaked transform is a 500mm translation, which is what makes the
   consequence visible: in the unsliced walk it displaces every item after
   the mapped item, and in a sliced walk only the items in the same range.
   -------------------------------------------------------------------- */
#900010 = CARTESIAN_POINT('mapped-origin',(0.,0.,0.));
#900011 = DIRECTION('mapped-z',(0.,0.,1.));
#900012 = DIRECTION('mapped-x',(1.,0.,0.));
#900013 = AXIS2_PLACEMENT_3D('mapped-origin-placement',#900010,#900011,#900012);
#900015 = CARTESIAN_POINT('not-a-representation',(1.,2.,3.));
#900014 = REPRESENTATION_MAP(#900013,#900015);
#900016 = CARTESIAN_POINT('leak-target',(500.,0.,0.));
#900017 = AXIS2_PLACEMENT_3D('leak-target-placement',#900016,#900011,#900012);
#900018 = MAPPED_ITEM('throws-after-pushing',#900014,#900017);

