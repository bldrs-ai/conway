#1321=IFCLOCALPLACEMENT($,#1322);
#1322=IFCAXIS2PLACEMENT3D(#1323,$,$);
#1323=IFCCARTESIANPOINT((0.,12.0,0.));
#1330=IFCPRODUCTDEFINITIONSHAPE($,$,(#1331));
#1331=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1332));
#1332=IFCEXTRUDEDAREASOLID(#1333,#1336,#23,0.5);
#1333=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1334,0.5,0.5);
#1334=IFCAXIS2PLACEMENT2D(#1335,$);
#1335=IFCCARTESIANPOINT((0.25,0.25));
#1336=IFCAXIS2PLACEMENT3D(#22,$,$);
#1340=IFCBUILDINGELEMENTPROXY('777777777777777777778N',$,'Filler12',$,$,#1341,#1350,$,$);
#1341=IFCLOCALPLACEMENT($,#1342);
#1342=IFCAXIS2PLACEMENT3D(#1343,$,$);
#1343=IFCCARTESIANPOINT((0.,13.0,0.));
#1350=IFCPRODUCTDEFINITIONSHAPE($,$,(#1351));
#1351=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1352));
#1352=IFCEXTRUDEDAREASOLID(#1353,#1356,#23,0.5);
#1353=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1354,0.5,0.5);
