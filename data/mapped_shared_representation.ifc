#1355=IFCCARTESIANPOINT((0.25,0.25));
#1356=IFCAXIS2PLACEMENT3D(#22,$,$);
#1360=IFCBUILDINGELEMENTPROXY('777777777777777777778O',$,'Filler13',$,$,#1361,#1370,$,$);
#1361=IFCLOCALPLACEMENT($,#1362);
#1362=IFCAXIS2PLACEMENT3D(#1363,$,$);
#1363=IFCCARTESIANPOINT((0.,14.0,0.));
#1370=IFCPRODUCTDEFINITIONSHAPE($,$,(#1371));
#1371=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1372));
#1372=IFCEXTRUDEDAREASOLID(#1373,#1376,#23,0.5);
#1373=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1374,0.5,0.5);
