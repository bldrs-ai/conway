ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('mapped_shared_representation.ifc','2026-08-18T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Minimal synthetic model exercising SHARED representation geometry across
   a batch boundary: one IfcRepresentationMap (#300) is mapped by two
   products that sit far apart in file order, with 14 filler products
   between them.

   Why the distance matters: the deferred demand pump extracts products in
   file order in batches, so any batch size from 2 to 15 places #1000 and
   #2000 in DIFFERENT batches. A release policy that frees everything a
   batch created therefore frees the mapped body while a later product
   still maps it — the case the smoke corpus cannot produce, because there
   every sharer of a definition falls inside one batch.

   The two mapped products share one mapped body but carry different
   object placements, so their placed geometry differs while their SOURCE
   geometry is one asset: a consumer must receive two boxes, at (0,0,0)
   and (10,0,0). Losing the second, or receiving it at the first's
   location, is the failure this fixture exists to catch. */
#1=IFCPROJECT('0mapped00SharedRep0000',$,'MappedSharedRepresentation',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11));
#11=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.0E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#23=IFCDIRECTION((0.,0.,1.));

/* The shared asset: a 1m cube body, wrapped in a representation map so
   many products can instance it. This is the geometry a refcounted
   release must keep alive until its LAST user has extracted. */
#300=IFCREPRESENTATIONMAP(#21,#310);
#310=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#311));
#311=IFCEXTRUDEDAREASOLID(#312,#316,#23,1.);
#312=IFCRECTANGLEPROFILEDEF(.AREA.,$,#313,1.,1.);
#313=IFCAXIS2PLACEMENT2D(#314,$);
#314=IFCCARTESIANPOINT((0.5,0.5));
#316=IFCAXIS2PLACEMENT3D(#22,$,$);

/* First user of the shared map, at the origin. */
#1000=IFCBUILDINGELEMENTPROXY('7777777777777777777772',$,'MappedFirst',$,$,#1001,#1010,$,$);
#1001=IFCLOCALPLACEMENT($,#1002);
#1002=IFCAXIS2PLACEMENT3D(#1003,$,$);
#1003=IFCCARTESIANPOINT((0.0,0.,0.));
#1010=IFCPRODUCTDEFINITIONSHAPE($,$,(#1011));
#1011=IFCSHAPEREPRESENTATION(#20,'Body','MappedRepresentation',(#1012));
#1012=IFCMAPPEDITEM(#300,#1013);
#1013=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#1014,1.,$);
#1014=IFCCARTESIANPOINT((0.,0.,0.));

/* Filler products with their OWN geometry, purely to push the second
   mapped product past a batch boundary. Each is a 0.5m cube stepped
   along +Y so nothing overlaps. */
#1100=IFCBUILDINGELEMENTPROXY('777777777777777777778B',$,'Filler00',$,$,#1101,#1110,$,$);
#1101=IFCLOCALPLACEMENT($,#1102);
#1102=IFCAXIS2PLACEMENT3D(#1103,$,$);
#1103=IFCCARTESIANPOINT((0.,1.0,0.));
#1110=IFCPRODUCTDEFINITIONSHAPE($,$,(#1111));
#1111=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1112));
#1112=IFCEXTRUDEDAREASOLID(#1113,#1116,#23,0.5);
#1113=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1114,0.5,0.5);
#1114=IFCAXIS2PLACEMENT2D(#1115,$);
#1115=IFCCARTESIANPOINT((0.25,0.25));
#1116=IFCAXIS2PLACEMENT3D(#22,$,$);
#1120=IFCBUILDINGELEMENTPROXY('777777777777777777778C',$,'Filler01',$,$,#1121,#1130,$,$);
#1121=IFCLOCALPLACEMENT($,#1122);
#1122=IFCAXIS2PLACEMENT3D(#1123,$,$);
#1123=IFCCARTESIANPOINT((0.,2.0,0.));
#1130=IFCPRODUCTDEFINITIONSHAPE($,$,(#1131));
#1131=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1132));
#1132=IFCEXTRUDEDAREASOLID(#1133,#1136,#23,0.5);
#1133=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1134,0.5,0.5);
#1134=IFCAXIS2PLACEMENT2D(#1135,$);
#1135=IFCCARTESIANPOINT((0.25,0.25));
#1136=IFCAXIS2PLACEMENT3D(#22,$,$);
#1140=IFCBUILDINGELEMENTPROXY('777777777777777777778D',$,'Filler02',$,$,#1141,#1150,$,$);
#1141=IFCLOCALPLACEMENT($,#1142);
#1142=IFCAXIS2PLACEMENT3D(#1143,$,$);
#1143=IFCCARTESIANPOINT((0.,3.0,0.));
#1150=IFCPRODUCTDEFINITIONSHAPE($,$,(#1151));
#1151=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1152));
#1152=IFCEXTRUDEDAREASOLID(#1153,#1156,#23,0.5);
#1153=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1154,0.5,0.5);
#1154=IFCAXIS2PLACEMENT2D(#1155,$);
#1155=IFCCARTESIANPOINT((0.25,0.25));
#1156=IFCAXIS2PLACEMENT3D(#22,$,$);
#1160=IFCBUILDINGELEMENTPROXY('777777777777777777778E',$,'Filler03',$,$,#1161,#1170,$,$);
#1161=IFCLOCALPLACEMENT($,#1162);
#1162=IFCAXIS2PLACEMENT3D(#1163,$,$);
#1163=IFCCARTESIANPOINT((0.,4.0,0.));
#1170=IFCPRODUCTDEFINITIONSHAPE($,$,(#1171));
#1171=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1172));
#1172=IFCEXTRUDEDAREASOLID(#1173,#1176,#23,0.5);
#1173=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1174,0.5,0.5);
#1174=IFCAXIS2PLACEMENT2D(#1175,$);
#1175=IFCCARTESIANPOINT((0.25,0.25));
#1176=IFCAXIS2PLACEMENT3D(#22,$,$);
#1180=IFCBUILDINGELEMENTPROXY('777777777777777777778F',$,'Filler04',$,$,#1181,#1190,$,$);
#1181=IFCLOCALPLACEMENT($,#1182);
#1182=IFCAXIS2PLACEMENT3D(#1183,$,$);
#1183=IFCCARTESIANPOINT((0.,5.0,0.));
#1190=IFCPRODUCTDEFINITIONSHAPE($,$,(#1191));
#1191=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1192));
#1192=IFCEXTRUDEDAREASOLID(#1193,#1196,#23,0.5);
#1193=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1194,0.5,0.5);
#1194=IFCAXIS2PLACEMENT2D(#1195,$);
#1195=IFCCARTESIANPOINT((0.25,0.25));
#1196=IFCAXIS2PLACEMENT3D(#22,$,$);
#1200=IFCBUILDINGELEMENTPROXY('777777777777777777778G',$,'Filler05',$,$,#1201,#1210,$,$);
#1201=IFCLOCALPLACEMENT($,#1202);
#1202=IFCAXIS2PLACEMENT3D(#1203,$,$);
#1203=IFCCARTESIANPOINT((0.,6.0,0.));
#1210=IFCPRODUCTDEFINITIONSHAPE($,$,(#1211));
#1211=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1212));
#1212=IFCEXTRUDEDAREASOLID(#1213,#1216,#23,0.5);
#1213=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1214,0.5,0.5);
#1214=IFCAXIS2PLACEMENT2D(#1215,$);
#1215=IFCCARTESIANPOINT((0.25,0.25));
#1216=IFCAXIS2PLACEMENT3D(#22,$,$);
#1220=IFCBUILDINGELEMENTPROXY('777777777777777777778H',$,'Filler06',$,$,#1221,#1230,$,$);
#1221=IFCLOCALPLACEMENT($,#1222);
#1222=IFCAXIS2PLACEMENT3D(#1223,$,$);
#1223=IFCCARTESIANPOINT((0.,7.0,0.));
#1230=IFCPRODUCTDEFINITIONSHAPE($,$,(#1231));
#1231=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1232));
#1232=IFCEXTRUDEDAREASOLID(#1233,#1236,#23,0.5);
#1233=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1234,0.5,0.5);
#1234=IFCAXIS2PLACEMENT2D(#1235,$);
#1235=IFCCARTESIANPOINT((0.25,0.25));
#1236=IFCAXIS2PLACEMENT3D(#22,$,$);
#1240=IFCBUILDINGELEMENTPROXY('777777777777777777778I',$,'Filler07',$,$,#1241,#1250,$,$);
#1241=IFCLOCALPLACEMENT($,#1242);
#1242=IFCAXIS2PLACEMENT3D(#1243,$,$);
#1243=IFCCARTESIANPOINT((0.,8.0,0.));
#1250=IFCPRODUCTDEFINITIONSHAPE($,$,(#1251));
#1251=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1252));
#1252=IFCEXTRUDEDAREASOLID(#1253,#1256,#23,0.5);
#1253=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1254,0.5,0.5);
#1254=IFCAXIS2PLACEMENT2D(#1255,$);
#1255=IFCCARTESIANPOINT((0.25,0.25));
#1256=IFCAXIS2PLACEMENT3D(#22,$,$);
#1260=IFCBUILDINGELEMENTPROXY('777777777777777777778J',$,'Filler08',$,$,#1261,#1270,$,$);
#1261=IFCLOCALPLACEMENT($,#1262);
#1262=IFCAXIS2PLACEMENT3D(#1263,$,$);
#1263=IFCCARTESIANPOINT((0.,9.0,0.));
#1270=IFCPRODUCTDEFINITIONSHAPE($,$,(#1271));
#1271=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1272));
#1272=IFCEXTRUDEDAREASOLID(#1273,#1276,#23,0.5);
#1273=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1274,0.5,0.5);
#1274=IFCAXIS2PLACEMENT2D(#1275,$);
#1275=IFCCARTESIANPOINT((0.25,0.25));
#1276=IFCAXIS2PLACEMENT3D(#22,$,$);
#1280=IFCBUILDINGELEMENTPROXY('777777777777777777778K',$,'Filler09',$,$,#1281,#1290,$,$);
#1281=IFCLOCALPLACEMENT($,#1282);
#1282=IFCAXIS2PLACEMENT3D(#1283,$,$);
#1283=IFCCARTESIANPOINT((0.,10.0,0.));
#1290=IFCPRODUCTDEFINITIONSHAPE($,$,(#1291));
#1291=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1292));
#1292=IFCEXTRUDEDAREASOLID(#1293,#1296,#23,0.5);
#1293=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1294,0.5,0.5);
#1294=IFCAXIS2PLACEMENT2D(#1295,$);
#1295=IFCCARTESIANPOINT((0.25,0.25));
#1296=IFCAXIS2PLACEMENT3D(#22,$,$);
#1300=IFCBUILDINGELEMENTPROXY('777777777777777777778L',$,'Filler10',$,$,#1301,#1310,$,$);
#1301=IFCLOCALPLACEMENT($,#1302);
#1302=IFCAXIS2PLACEMENT3D(#1303,$,$);
#1303=IFCCARTESIANPOINT((0.,11.0,0.));
