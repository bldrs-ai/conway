#1001=IFCLOCALPLACEMENT(#101,#1010);
#1002=IFCPRODUCTDEFINITIONSHAPE($,$,(#1003));
#1003=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#1004));
#1004=IFCEXTRUDEDAREASOLID(#1005,#1008,#23,1.);
#1005=IFCRECTANGLEPROFILEDEF(.AREA.,$,#1006,1.,1.);
#1006=IFCAXIS2PLACEMENT2D(#1007,$);
#1007=IFCCARTESIANPOINT((0.5,0.5));
#1008=IFCAXIS2PLACEMENT3D(#1009,$,$);
