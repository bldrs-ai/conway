ISO-10303-21;
HEADER;
FILE_DESCRIPTION ('AP214 reachability-arms fixture (bldrs-ai/conway#564 5). Three representations, each reaching its geometry by a path the extent collector has to mirror and could plausibly miss: a MANIFOLD_SURFACE_SHAPE_REPRESENTATION (a shape_representation SUBTYPE, invisible to an exact-type types() scan), a MANIFOLD_SOLID_BREP reachable only through a STYLED_ITEM, and a FACE_BASED_SURFACE_MODEL. The styled representation also lists a second STYLED_ITEM carrying only a POINT_STYLE - no SURFACE_STYLE_USAGE - wrapping a far larger BREP: extraction refuses to tessellate that target, so the collector must refuse to take its extent from it. Every face here is a planar triangle: the point is which faces the walk REACHES, not what they tessellate to.','2;1');
FILE_NAME('ap214-reachability-arms','2026-01-01T00:00:00',('test'),('bldrs'),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
