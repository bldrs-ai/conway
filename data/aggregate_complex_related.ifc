ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('aggregate_complex_related.ifc','2026-08-23T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* One IfcRelAggregates whose RelatedObjects hold a STEP complex
   (external-mapping) instance, #300, among ordinary parts.

   ISO-10303-21 allows an instance to be written as a parenthesised list of
   entity variants. conway's parser records the CONTAINER under type 0
   (EXTERNALMAPPINGCONTAINER — see the `typeID: 0` special case in
   step_parser.ts) and keeps the variants in the entry's `multiMapping`;
   getTypedElementByExpressID then searches those variants, so it hands back
   the IfcBuildingElementPart while the typeID column says "not a product".

   That disagreement is what this fixture exists for: a prefetch that
   classified related objects from the column would omit #300, and on a
   windowed source the aggregates pass would then read it unpaged, throw
   StepBufferNotResidentError into its own permissive catch, and abandon the
   rest of the relationship (conway#566 review).

   No corpus model contains a complex instance — 0 across 24 files and
   13.4 M records — so this is the only place the case is exercised. */
#1=IFCPROJECT('7R4zLX4Ig7gZo1e$WUaJt2',$,'ComplexRelated',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11));
#11=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.0E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#23=IFCDIRECTION((0.,0.,1.));
#100=IFCELEMENTASSEMBLY('B168kqnXlLLUZXX1McG7A2',$,'Assembly',$,$,#101,$,$,$,.NOTDEFINED.);
#101=IFCLOCALPLACEMENT($,#21);
/* An ordinary part, for contrast. */
#200=IFCBUILDINGELEMENTPART('hNsC_JuNDY$Li35ats68Q0',$,'PlainPart',$,$,#201,$,$,$);
#201=IFCLOCALPLACEMENT(#101,#21);
/* The complex instance: an IfcProduct variant packed with a non-product one. */
#300=(IFCBUILDINGELEMENTPART('VTd2je089giQyepJP4kQv3',$,'ComplexPart',$,$,#301,$,$,$)IFCGROUP('h9J5vsegHiGEkqSF9rYo83',$,'Alias',$));
#301=IFCLOCALPLACEMENT(#101,#21);
/* A non-product, so the list exercises both classifications. */
#400=IFCGROUP('J4C6v85fvdD_UHi3ilxiR3',$,'NotAProduct',$);
#500=IFCRELAGGREGATES('QUmtfQd9qJPhfrJ3GWFGi3',$,$,$,#100,(#200,#400,#300));
ENDSEC;
END-ISO-10303-21;
