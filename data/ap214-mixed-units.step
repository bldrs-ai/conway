ISO-10303-21;
HEADER;
FILE_DESCRIPTION ('AP214 mixed length-unit assembly: two advanced-brep representations whose GLOBAL_UNIT_ASSIGNED_CONTEXTs declare different length units, so their raw coordinates are numerically incomparable. Fixture for the per-face model-extent deflection floor (bldrs-ai/conway#564).','2;1');
FILE_NAME('ap214-mixed-units','2026-01-01T00:00:00',('test'),('bldrs'),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#2);
#2 = APPLICATION_CONTEXT('mechanical design');
#10 = CARTESIAN_POINT('',(0.,0.,0.));
#20 = DIRECTION('',(0.,0.,1.));
#21 = DIRECTION('',(1.,0.,0.));
#30 = AXIS2_PLACEMENT_3D('',#10,#20,#21);
/* millimetre context */
#100 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#104)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#101,#102,#103)) REPRESENTATION_CONTEXT('Context','3D') );
#101 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#102 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#103 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#104 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#101,'','');
/* metre context */
#150 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#154)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#151,#152,#153)) REPRESENTATION_CONTEXT('Context','3D') );
#151 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.) );
#152 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#153 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#154 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#151,'','');
/* the millimetre body: a 1000 x 1000 x 1000 unit span */
#300 = CARTESIAN_POINT('',(0.,0.,0.));
#301 = CARTESIAN_POINT('',(1000.,1000.,1000.));
#310 = VERTEX_POINT('',#300);
#311 = VERTEX_POINT('',#301);
#312 = PLANE('',#30);
#313 = ADVANCED_FACE('mm face',(),#312,.T.);
#314 = CLOSED_SHELL('',(#313));
#315 = MANIFOLD_SOLID_BREP('mm solid',#314);
/* the metre body: a 1 x 1 x 1 unit span, i.e. the same physical size */
#320 = CARTESIAN_POINT('',(0.,0.,0.));
#321 = CARTESIAN_POINT('',(1.,1.,1.));
#330 = VERTEX_POINT('',#320);
#331 = VERTEX_POINT('',#321);
#332 = PLANE('',#30);
#333 = ADVANCED_FACE('m face',(),#332,.T.);
#334 = CLOSED_SHELL('',(#333));
#335 = MANIFOLD_SOLID_BREP('m solid',#334);
#400 = ADVANCED_BREP_SHAPE_REPRESENTATION('mm body',(#315),#100);
#410 = ADVANCED_BREP_SHAPE_REPRESENTATION('m body',(#335),#150);
#500 = PRODUCT_CONTEXT('',#2,'mechanical');
#501 = PRODUCT_DEFINITION_CONTEXT('part definition',#2,'design');
#510 = PRODUCT('mixed','mixed','',(#500));
#511 = PRODUCT_DEFINITION_FORMATION('','',#510);
#512 = PRODUCT_DEFINITION('','',#511,#501);
#513 = PRODUCT_DEFINITION_SHAPE('','',#512);
#514 = SHAPE_DEFINITION_REPRESENTATION(#513,#400);
ENDSEC;
END-ISO-10303-21;
